# Bullseye Configuration File
# This file demonstrates the configuration options for Bullseye

# ==================== Basic Settings ====================
max_open_trades: 5
stake_currency: USDT
stake_amount: 100
tradable_balance_ratio: 0.99
fiat_display_currency: USD
dry_run: true
dry_run_wallet: 1000

# ==================== Market Type ====================
# Options: auto, crypto, stock, future
# - auto: Auto-detect based on pair format
# - crypto: Cryptocurrency markets (Binance, OKX, etc.)
# - stock: Stock markets (Chinese A-shares via XTP, TORA, etc.)
# - future: Futures markets (Chinese futures via CTP)
market_type: auto

# ==================== Settlement Configuration (T+0/T+1) ====================
# Settlement rules control when a position can be sold after opening.
# T+0: Can sell immediately (crypto, US stocks, HK stocks, futures)
# T+1: Can sell next trading day (Chinese A-shares)
# T+2: Can sell in 2 trading days (some markets)
settlement:
  # Mode: "auto" (auto-detect) or "manual"
  # Auto-detection uses pair format to determine settlement type:
  # - A-shares (000001.SZ, 600000.SH): T+1
  # - Crypto (BTC/USDT): T+0
  # - US Stocks (AAPL, GOOGL): T+0
  # - HK Stocks (00700.HK): T+0
  # - Futures (AU2506@SHFE): T+0
  mode: auto

  # Per-pair overrides - use this to override auto-detection
  # Format: "PAIR": "t0" | "t1" | "t2"
  overrides:
    # Examples:
    # "CUSTOM.PAIR": "t1"      # Force custom pair to T+1
    # "SPECIAL/USDT": "t0"     # Force crypto to T+0
    # For Chinese A-shares, auto-detection should work correctly,
    # but you can override if needed:
    # "000001.SZ": "t1"        # Explicit A-share T+1

  # Default settlement type for unknown pairs (when auto-detection fails)
  # Set to "t1" if you primarily trade A-shares with custom pair formats
  default: t0

# ==================== Exchange Configuration ====================
exchange:
  name: binance
  key: ""
  secret: ""
  passphrase: ""  # Required for some exchanges like OKX
  sandbox: false
  ccxt_config: {}
  ccxt_async_config: {}

# ==================== Stock Configuration (China) ====================
stock:
  # Gateway: xtp, tora, ost, emt
  gateway: xtp

  # XTP Configuration
  userid: ""
  password: ""
  client_id: 1
  session_id: 1
  md_ip: "120.27.164.138"
  md_port: 6002
  td_ip: "120.27.164.138"
  td_port: 6001

  # Datafeed for historical data
  datafeed: tushare
  tushare_token: ""

# ==================== Futures Configuration (China) ====================
future:
  # Gateway: ctp, minictp, femas, uft
  gateway: ctp

  # CTP Configuration
  userid: ""
  password: ""
  brokerid: "9999"  # SimNow broker ID
  td_address: "tcp://180.168.146.187:10130"
  md_address: "tcp://180.168.146.187:10131"

  # Real trading (optional)
  appid: ""
  auth_code: ""
  product_info: ""

# ==================== Pairlist Configuration ====================
pairlist:
  - method: StaticPairList
    config:
      pairs:
        - BTC/USDT
        - ETH/USDT
        - BNB/USDT

  - method: VolumePairList
    config:
      number_assets: 20
      sort_key: volume
      refresh_period: 86400

  - method: PrecisionFilter
  - method: PriceFilter
    config:
      low_price_ratio: 0.01

  - method: SpreadFilter
    config:
      max_spread_ratio: 0.005

# ==================== Strategy Configuration ====================
strategy: MyStrategy
strategy_path: user_data/strategies

# ==================== Backtesting Configuration ====================
backtest:
  timeframe: 5m
  timerange: 20240101-20241231
  max_open_trades: 5
  position_stacking: false
  enable_position_stacking: false
  fee: 0.001

# ==================== Hyperopt Configuration ====================
hyperopt:
  epochs: 100
  spaces: all  # buy, sell, roi, stoploss, trailing
  loss_function: SharpeHyperOptLoss
  hyperopt_jobs: -1
  target_trades: 30
  min_trades: 1

# ==================== Database Configuration ====================
# SQLite (default)
db_url: sqlite:///user_data/tradesv3.sqlite

# PostgreSQL (optional)
# db_url: postgresql://user:password@localhost:5432/bullseye

# MySQL (optional)
# db_url: mysql://user:password@localhost:3306/bullseye

# ==================== Telegram Configuration ====================
telegram:
  enabled: false
  token: ""
  chat_id: ""
  notification_settings:
    status: warning
    warning: on
    startup: on
    entry: on
    entry_fill: on
    exit: on
    exit_fill: on
    protection_trigger: on
    show_candle: off
    strategy_msg: on

# ==================== API Server Configuration ====================
api_server:
  enabled: false
  listen_ip: 127.0.0.1
  listen_port: 8080
  verbosity: error
  enable_openapi: true
  jwt_secret_key: ""
  ws_token: ""
  CORS_origins: []
  username: ""
  password: ""

# ==================== Logging Configuration ====================
logfile: user_data/logs/bullseye.log
log_level: INFO

# ==================== Additional Settings ====================
internals:
  process_throttle_secs: 5

# ==================== Protections ====================
protections: []
